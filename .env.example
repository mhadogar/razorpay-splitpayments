RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxx

VTEX_ENABLED=false
VTEX_BASE_URL=https://youraccount.vtexcommercestable.com.br
VTEX_APP_KEY=your_vtex_app_key
VTEX_APP_TOKEN=your_vtex_app_token
VTEX_MASTERDATA_ENTITY=SL
# Set true to test only till VTEX seller fetch stage.
VTEX_SELLER_FETCH_ONLY=false

PORTAL_ENABLED=true
PORTAL_PORT=3030

# Every 10 minutes
SCHEDULER_CRON=*/30 * * * *

# Fetch window relative to now:
# from = now - PAYMENT_WINDOW_FROM_DAYS_AGO
# to   = now - PAYMENT_WINDOW_TO_DAYS_AGO
PAYMENT_WINDOW_FROM_DAYS_AGO=45
PAYMENT_WINDOW_TO_DAYS_AGO=15

# Razorpay max 100 per API request
MAX_PAYMENTS_PER_PAGE=100

# Number of pages to fetch per scheduler cycle
MAX_PAGES_PER_RUN=100

# Hold funds for refunds
HOLD_DAYS=15
CURRENCY=INR
MIN_TRANSFER_AMOUNT=100

STATE_FILE=./data/state.json
VENDOR_FILE=./data/vendors.json

# Log Razorpay request/response payloads
LOG_RAZORPAY_PAYLOADS=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Optional: prefer password hash in production and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change_this_session_secret
SESSION_SECURE_COOKIE=false

# Fetch-only test mode:
# true  -> uses PAYMENT_WINDOW_FROM_DAYS_AGO / PAYMENT_WINDOW_TO_DAYS_AGO
# false -> fetches latest pages without from/to filter
FETCH_USE_TIME_WINDOW=true
